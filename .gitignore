# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# --- data (never commit corpora / teacher dumps) ---
# NOTE: these MUST stay root-anchored.  An unanchored `data/` also matches the Python package
# `parakeet/data/`, which silently kept the whole data pipeline (tokenizer, teacher backends,
# feature cache, datasets, curation) out of the repository for the first ten commits.
/data/
/runs/
/checkpoints/
*.wav
*.flac
*.mp3
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
!assets/**/*.wav

# --- secrets ---
.env
*.key
secrets.yaml

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# API keys and other local secrets -- never committed
/.secrets/
*.key


# the DirectML experiment venv (Python 3.11, torch-directml; ~700 MB)
/.venv-dml/

# the listenable demo pack is small and is the artifact (regenerate: scripts/demo_pack.py)
!docs/demo/*.wav

# the flow demo pack (same rationale as docs/demo)
!docs/demo_flow/*.wav
